{
  "Urls": "http://0.0.0.0:8090",
  "ConnectionStrings": {
    "Consolidation": "Data Source=data/consolidation.db"
  },
  "WmsApi": {
    "BaseUrl": "http://127.0.0.1:5000/",
    "BearerToken": "",
    "RequestTimeoutSeconds": 30,
    "PageSize": 1000,
    "StocksPath": "wms/stock/stocksQuery",
    "CellsPath": "wms/cell/pagedCellsGet",
    "BoxesPath": "wms/box/pagedBoxesGet",
    "AgvTasksPath": "wms/agvtask/paged-list",
    "CreateMoveTaskPath": "wms/stock/createStockTaskV2"
  },
  "Consolidation": {
    "Enabled": true,
    "ExecutionEnabled": false,
    "RequireManualConfirmation": true,
    "OperatorKey": "",
    "Rows": [12, 11, 10, 9, 8, 7, 6, 5, 4],
    "LayerOrder": [2, 1],
    "AllowCrossRow": true,
    "ExcludedRanges": [
      { "From": "4F056301", "To": "4F056601" },
      { "From": "4F044101", "To": "4F046601" }
    ],
    "BufferCells": [
      "4B07001", "4B08001", "4B09001", "4B10001", "4B11001", "4B12001",
      "4B13001", "4B14001", "4B15001", "4B16001", "4B17001", "4B18001"
    ],
    "MinimumEmptyBufferCells": 1,
    "PollIntervalSeconds": 5,
    "TaskTimeoutMinutes": 60,
    "StrictSerialExecution": true,
    "StopOnDataChange": true,
    "StopOnTaskFailure": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
