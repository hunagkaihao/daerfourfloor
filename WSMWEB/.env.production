# Whether to open mock
VITE_USE_MOCK = true

# public path
VITE_PUBLIC_PATH = /

# Delete console
VITE_DROP_CONSOLE = true

# Whether to enable gzip or brotli compression
# Optional: gzip | brotli | none
# If you need multiple forms, you can use `,` to separate
VITE_BUILD_COMPRESS = 'gzip'

# Whether to delete origin files when using compress, default false
VITE_BUILD_COMPRESS_DELETE_ORIGIN_FILE = false

# Basic interface address SPA
VITE_GLOB_API_URL = http://192.168.20.93:5001

# File upload address， optional
# It can be forwarded by nginx or write the actual address directly
VITE_GLOB_UPLOAD_URL=/upload

# Interface prefix
VITE_GLOB_API_URL_PREFIX=

# 四楼货物整理入口（生产建议通过同域反向代理访问）
VITE_GLOB_CONSOLIDATION_ENABLED = false
VITE_GLOB_CONSOLIDATION_TITLE = 货物整理
VITE_GLOB_CONSOLIDATION_URL = /warehouse-consolidation/
VITE_GLOB_CONSOLIDATION_OPEN_MODE = redirect

# Whether to enable image compression
VITE_USE_IMAGEMIN= true

# use pwa
VITE_USE_PWA = false

# Is it compatible with older browsers 低版本兼容
VITE_LEGACY = true


# 认证授权服务器地址
#VITE_AUTH_URL= http://120.24.194.14:8013
VITE_AUTH_URL= http://192.168.0.180:8013
# 接口地址
#VITE_API_URL= http://120.24.194.14:5000/gateway
VITE_API_URL= http://192.168.20.93:5001

# WEBSOCKE 地址
#VITE_WEBSOCKE_URL= http://120.24.194.14:8014/ws
VITE_WEBSOCKE_URL= http://192.168.0.180:8014/ws
